{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.2",
  "runtime": {
    "executor": "antigravity",
    "mode": "single-agent",
    "notes": "Options: antigravity, codex, pi, opencode, claude",
    "interaction_mode": "supervised",
    "interactive_gates": [
      "P03_blueprint",
      "P04_propose",
      "P09_compliance"
    ]
  },
  "execution_authority": {
    "evidence": null,
    "operations": [],
    "delegated_decisions": [],
    "expires_at": null,
    "revoked": false
  },
  "workspace": {
    "isolation": "worktree",
    "worktree_pattern": "../{repo}-worktrees/{branch}",
    "notes": "Options: inline (same directory), worktree (separate git worktree)"
  },
  "quality_gates": {
    "reproduction_test_mandatory": true,
    "ast_skeleton_first": true,
    "max_consecutive_failures_before_rollback": 3
  },
  "models": {
    "tier1_frontier": "gemini-3.8-flash",
    "tier2_local": "qwen-2.5-7b-rocm"
  },
  "observability": {
    "flight_recorder": true,
    "log_path": ".q-agent/flight_recorder.log",
    "eval_level": "standard",
    "notes_eval_level": "Options: minimal (outcome + policy), standard (default: adds decision, evidence, tools, routing, retries), enterprise (adds cost + latency)"
  },
  "context_retrieval": {
    "mode": "on-demand",
    "project_id": null,
    "local_sources": [
      "project-files"
    ],
    "require_project_scope": true,
    "allow_cross_project": false,
    "budget": {
      "max_results": 3,
      "max_chars": 6000,
      "max_tokens_estimate": 1500
    },
    "providers": {
      "gbrain": {
        "enabled": false,
        "availability": "unknown",
        "authorization": "none",
        "authorization_evidence": null,
        "scope_class": "private-project",
        "capabilities": [],
        "project_scope": null
      },
      "engram": {
        "enabled": false,
        "availability": "unknown",
        "authorization": "none",
        "authorization_evidence": null,
        "scope_class": "private-project",
        "capabilities": [],
        "project_scope": null
      },
      "skillvault": {
        "enabled": false,
        "availability": "unknown",
        "authorization": "none",
        "authorization_evidence": null,
        "scope_class": "private-project",
        "capabilities": [],
        "project_scope": null
      }
    },
    "persistence": {
      "local_first": true,
      "external_write": false,
      "sqlite_backup": false
    }
  },
  "integrations": {
    "github_issues": true,
    "gbrain_mcp": false,
    "engram_mcp": false
  },
  "audit": {
    "mode": "atomic_dispatch",
    "notes_mode": "Options: atomic_dispatch (new — one agent per item, manifest-driven), legacy (monolithic megaprompt)",
    "manifest": "references/audit-manifest.yml",
    "level": 0,
    "notes_level": "0=MVP/Bootstrap (5 items), 1=Growth (13 items), 2=Maturity (17 items)",
    "max_retries_per_item": 2,
    "aggregator_script": "tools/q-audit-aggregator/generate_report.py",
    "validator_script": "tools/q-audit-validator/validate_audit.py"
  },
  "guardrails": {
    "fs_write_allowed": ["src/**", "tests/**", "docs/**", "features/**", "odd/**", "q-tasks/**"],
    "fs_write_denied": [".git/**", "references/**", "templates/**"],
    "shell_denied": ["rm -rf /", "rm -rf ~*", "git push --force*", "sudo *"]
  }
}
