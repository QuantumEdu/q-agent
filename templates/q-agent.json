{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.2",
  "runtime": {
    "executor": "antigravity",
    "mode": "single-agent",
    "notes": "Options: antigravity, codex, pi, opencode, claude",
    "interaction_mode": "supervised",
    "interactive_gates": [
      "P03_blueprint",
      "P04_propose",
      "P09_compliance"
    ]
  },
  "workspace": {
    "isolation": "worktree",
    "worktree_pattern": "../{repo}-worktrees/{branch}",
    "notes": "Options: inline (same directory), worktree (separate git worktree)"
  },
  "quality_gates": {
    "reproduction_test_mandatory": true,
    "ast_skeleton_first": true,
    "max_consecutive_failures_before_rollback": 3
  },
  "models": {
    "tier1_frontier": "gemini-3.8-flash",
    "tier2_local": "qwen-2.5-7b-rocm"
  },
  "observability": {
    "flight_recorder": true,
    "log_path": ".q-agent/flight_recorder.log",
    "eval_level": "standard",
    "notes_eval_level": "Options: minimal (outcome + policy), standard (default: adds decision, evidence, tools, routing, retries), enterprise (adds cost + latency)"
  },
  "integrations": {
    "github_issues": true,
    "gbrain_mcp": false,
    "engram_mcp": false
  },
  "audit": {
    "mode": "atomic_dispatch",
    "notes_mode": "Options: atomic_dispatch (new — one agent per item, manifest-driven), legacy (monolithic megaprompt)",
    "manifest": "references/audit-manifest.yml",
    "level": 0,
    "notes_level": "0=MVP/Bootstrap (5 items), 1=Growth (13 items), 2=Maturity (17 items)",
    "max_retries_per_item": 2,
    "aggregator_script": "tools/q-audit-aggregator/generate_report.py",
    "validator_script": "tools/q-audit-validator/validate_audit.py"
  }
}
