n159\t        with self.lock():\n160\t            self.recover()\n161\t            task = self.task(task_id)\n162\t            old = self.db.execute(\"SELECT * FROM attempts WHERE request_id=?\", (request_id,)).fetchone()\n163\t            if old:\n164\t                if (old[\"task_id\"], old[\"operation\"], old[\"command\"], old[\"timeout\"]) != (task_id, operation, encoded, timeout):\n165\t                    raise ValueError(\"Request ID conflicts with an existing operation\")\n166\t                if ((old['min_free_bytes'] is not None and old['min_free_bytes'] != min_free_mib * MIB)\n167\t                        or (old['max_log_bytes'] is not None and old['max_log_bytes'] != max_log_mib * MIB)):\n168\t                    raise ValueError('Request ID conflicts with existing resource/output settings')\n169\t                if (old['required_capabilities'] or '[]') != json.dumps(required):\n170\t                    raise ValueError('Request ID conflicts with existing capability requirements')\n171\t                return dict(old)\n172\t            if task[\"state\"] in {\"failed\", \"uncertain\"} or (operation == \"run\" and task[\"state\"] != \"pending\"):\n173\t                raise ValueError(\"Inspect existing effects and use retry explicitly before dispatch\")\n174\t            head, clean = self.checkout()\n175\t            if operation == \"verify\" and not clean:\n176\t                raise ValueError(\"Commit changes and exclude .cache/ before commit-bound verification\")\n177\t            admission = resources(self.root, min_free_mib * MIB)\n178\t            if not admission['admitted']:\n179\t                raise ValueError('Resource admission rejected: ' + admission['reason'])\n180\t            require_capabilities(required)\n181\t            # Random log names never interpret request IDs as paths.\n182\t            import uuid\n183\t            log = self.directory / (uuid.uuid4().hex + \".log\")\n184\t            with self.db:\n185\t                self.db.execute(\"INSERT INTO attempts (request_id,task_id,operation,command,timeout,state,\"\n186\t                                \"commit_sha,started_at,log_path,min_free_bytes,max_log_bytes,required_capabilities) VALUES (?,?,?,?,?,'running',?,?,?,?,?,?)\",\n187\t                                (request_id, task_id, operation, encoded, timeout, head, now(), str(log),\n188\t                                 min_free_mib * MIB, max_log_mib * MIB, json.dumps(required)))\n189\t                self.db.execute(\"UPDATE tasks SET state='running' WHERE id=?\", (task_id,))\n190\t            child = None\n191\t            exit_code, error = None, None\n192\t            capture = None\n193\t            with command_signals() as received:\n194\t                try:\n195\t                    prune_logs(self.directory, [row[0] for row in self.db.execute(\n196\t                        'SELECT log_path FROM attempts ORDER BY rowid DESC')])\n197\t                    with log.open(\"x+b\") as output:\n198\t                        os.chmod(log, 0o600)\n199\t                        capture = BoundedOutput(output, max_log_mib * MIB)\n200\t                        child = subprocess.Popen(command, cwd=self.root, stdin=subprocess.DEVNULL,\n201\t                                                 stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)\n202\t                        with self.db:\n203\t                            self.db.execute(\"UPDATE attempts SET child_pid=? WHERE request_id=?\", (child.pid, request_id))\n204\t                        error = capture_command(child, timeout, received, capture)\n205\t                except OSError:\n206\t                    error = \"launch_or_log_failed\"\n207\t                finally:\n208\t                    if child is not None:\n209\t                        # Only this freshly spawned group is ours; never act on saved PIDs.\n210\t                        try:\n211\t                            os.killpg(child.pid, si